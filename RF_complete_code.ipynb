"""
02_rusle_rf_hybrid_model.py

Hybrid RUSLE-Random Forest (RF) model for spatial soil loss estimation and
erosion risk classification, Southern Ewaso Ng'iro Basin, Kenya.

Architecture
------------
1. Random Forest Regressor  -> continuous soil loss (t ha-1 yr-1)
2. Random Forest Classifier -> erosion severity class (balanced class weights)
3. Analytic RUSLE soil loss (A = R x K x LS x C x P) computed in preprocessing
   is combined with the RF regressor's prediction via a stacked Ridge
   meta-learner, so that RUSLE acts as a physically grounded bias-correction
   signal on top of the RF's nonlinear, data-driven estimate.
4. Naive averaging and standalone RUSLE / standalone RF are also evaluated
   as baselines for comparison, per the manuscript.

Hyperparameters (RF): n_estimators=200, max_depth=20, min_samples_split=5,
min_samples_leaf=2, class_weight='balanced' for the classifier.
Data split: 70:30, stratified by erosion class.
Feature importance: Gini impurity-based (Strobl et al., 2007).

Author: [Corresponding author name] et al.
License: MIT (see LICENSE)
"""

from pathlib import Path

import joblib
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns
from sklearn.ensemble import RandomForestClassifier, RandomForestRegressor
from sklearn.linear_model import RidgeCV
from sklearn.metrics import (
    accuracy_score, auc, f1_score, mean_absolute_error,
    mean_squared_error, precision_score, r2_score, roc_auc_score, roc_curve,
)
from sklearn.model_selection import GridSearchCV, train_test_split

RANDOM_STATE = 42

RF_PARAMS = dict(
    n_estimators=200,
    max_depth=20,
    min_samples_split=5,
    min_samples_leaf=2,
    random_state=RANDOM_STATE,
    n_jobs=-1,
)

RUSLE_FACTORS = ["R", "K", "LS", "C", "P"]
EXTENDED_FEATURES = [
    "elevation", "slope_deg", "aspect_deg", "tpi", "tri",
    "ndvi", "mdvi", "clay_pct", "sand_pct", "silt_pct",
    "bulk_density", "soc_pct",
]
ALL_FEATURES = RUSLE_FACTORS + EXTENDED_FEATURES  # 17 predictors


# ---------------------------------------------------------------------------
# Nash-Sutcliffe Efficiency (not in sklearn — implemented directly)
# ---------------------------------------------------------------------------

def nash_sutcliffe_efficiency(y_true, y_pred) -> float:
    y_true, y_pred = np.asarray(y_true), np.asarray(y_pred)
    numerator = np.sum((y_true - y_pred) ** 2)
    denominator = np.sum((y_true - np.mean(y_true)) ** 2)
    return 1 - (numerator / denominator)


# ---------------------------------------------------------------------------
# Data split
# ---------------------------------------------------------------------------

def split_data(X, y_reg, y_clf, test_size: float = 0.30):
    """70:30 split, stratified by erosion severity class."""
    return train_test_split(
        X, y_reg, y_clf,
        test_size=test_size,
        stratify=y_clf,
        random_state=RANDOM_STATE,
    )


# ---------------------------------------------------------------------------
# Model training
# ---------------------------------------------------------------------------

def tune_rf_regressor(X_train, y_train, param_grid=None, cv: int = 5):
    """Optional grid search around the reported hyperparameters."""
    param_grid = param_grid or {
        "n_estimators": [100, 200, 300],
        "max_depth": [10, 20, None],
        "min_samples_split": [2, 5, 10],
        "min_samples_leaf": [1, 2, 4],
    }
    base = RandomForestRegressor(random_state=RANDOM_STATE, n_jobs=-1)
    search = GridSearchCV(base, param_grid, cv=cv, scoring="r2", n_jobs=-1)
    search.fit(X_train, y_train)
    print(f"Best RF regressor params: {search.best_params_}")
    return search.best_estimator_


def train_rf_regressor(X_train, y_train) -> RandomForestRegressor:
    model = RandomForestRegressor(**RF_PARAMS)
    model.fit(X_train, y_train)
    return model


def train_rf_classifier(X_train, y_train) -> RandomForestClassifier:
    model = RandomForestClassifier(**RF_PARAMS, class_weight="balanced")
    model.fit(X_train, y_train)
    return model


def train_stacked_ridge_ensemble(rf_pred_train, rusle_pred_train, y_train):
    """
    Stacked Ridge meta-learner: combines the RF regressor's prediction with
    the analytic RUSLE soil-loss estimate, letting RUSLE act as a bias
    correction on the RF output rather than a naive average of the two.
    """
    meta_X_train = np.column_stack([rf_pred_train, rusle_pred_train])
    meta_model = RidgeCV(alphas=np.logspace(-3, 3, 25), cv=5)
    meta_model.fit(meta_X_train, y_train)
    print(f"Ridge meta-learner coefficients (RF, RUSLE): {meta_model.coef_}, "
          f"intercept: {meta_model.intercept_:.4f}, alpha: {meta_model.alpha_:.4f}")
    return meta_model


# ---------------------------------------------------------------------------
# Baseline comparators
# ---------------------------------------------------------------------------

def naive_average(rf_pred, rusle_pred):
    return (rf_pred + rusle_pred) / 2.0


def weighted_average(rf_pred, rusle_pred, w_rf: float = 0.7):
    return w_rf * rf_pred + (1 - w_rf) * rusle_pred


# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------

def evaluate_regression(y_true, y_pred, label: str) -> dict:
    metrics = {
        "R2": r2_score(y_true, y_pred),
        "RMSE": np.sqrt(mean_squared_error(y_true, y_pred)),
        "MAE": mean_absolute_error(y_true, y_pred),
        "NSE": nash_sutcliffe_efficiency(y_true, y_pred),
    }
    print(f"\n[{label}] R2={metrics['R2']:.3f}  RMSE={metrics['RMSE']:.3f}  "
          f"MAE={metrics['MAE']:.3f}  NSE={metrics['NSE']:.3f}")
    return metrics


def evaluate_classification(y_true, y_pred, y_proba, classes, label: str) -> dict:
    metrics = {
        "accuracy": accuracy_score(y_true, y_pred),
        "precision_macro": precision_score(y_true, y_pred, average="macro", zero_division=0),
        "f1_macro": f1_score(y_true, y_pred, average="macro", zero_division=0),
    }

    if y_proba is not None and len(classes) > 1:
        try:
            metrics["auc_roc_macro"] = roc_auc_score(
                y_true, y_proba, multi_class="ovr", average="macro"
            )
        except ValueError:
            metrics["auc_roc_macro"] = np.nan

    print(f"\n[{label}] Accuracy={metrics['accuracy']:.3f}  "
          f"Precision(macro)={metrics['precision_macro']:.3f}  "
          f"F1(macro)={metrics['f1_macro']:.3f}  "
          f"AUC-ROC(macro)={metrics.get('auc_roc_macro', float('nan')):.3f}")
    return metrics


def per_class_auc(y_true, y_proba, classes) -> pd.Series:
    y_true_bin = pd.get_dummies(y_true)[classes].values
    aucs = {}
    for i, cls in enumerate(classes):
        fpr, tpr, _ = roc_curve(y_true_bin[:, i], y_proba[:, i])
        aucs[cls] = auc(fpr, tpr)
    return pd.Series(aucs).sort_values(ascending=False)


# ---------------------------------------------------------------------------
# Feature importance
# ---------------------------------------------------------------------------

def get_feature_importance(model, feature_names) -> pd.DataFrame:
    return (
        pd.DataFrame({"feature": feature_names, "importance": model.feature_importances_})
        .sort_values("importance", ascending=False)
        .reset_index(drop=True)
    )


# ---------------------------------------------------------------------------
# Plots
# ---------------------------------------------------------------------------

def plot_diagnostics(y_test, y_pred_hybrid, feature_importance, outdir="outputs"):
    Path(outdir).mkdir(parents=True, exist_ok=True)
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))

    axes[0, 0].barh(feature_importance["feature"][:17], feature_importance["importance"][:17])
    axes[0, 0].invert_yaxis()
    axes[0, 0].set_title("Random Forest Feature Importance (Gini)")
    axes[0, 0].set_xlabel("Importance")

    axes[0, 1].scatter(y_test, y_pred_hybrid, alpha=0.5)
    lims = [min(y_test.min(), y_pred_hybrid.min()), max(y_test.max(), y_pred_hybrid.max())]
    axes[0, 1].plot(lims, lims, "r--", lw=2)
    axes[0, 1].set_xlabel("Observed soil loss (t ha-1 yr-1)")
    axes[0, 1].set_ylabel("Predicted soil loss (t ha-1 yr-1)")
    axes[0, 1].set_title("Hybrid model: observed vs predicted")

    residuals = y_test - y_pred_hybrid
    axes[1, 0].scatter(y_pred_hybrid, residuals, alpha=0.5)
    axes[1, 0].axhline(0, color="r", linestyle="--")
    axes[1, 0].set_xlabel("Predicted")
    axes[1, 0].set_ylabel("Residual")
    axes[1, 0].set_title("Residual plot")

    axes[1, 1].hist(residuals, bins=30, edgecolor="black")
    axes[1, 1].set_xlabel("Residual")
    axes[1, 1].set_ylabel("Frequency")
    axes[1, 1].set_title("Residual distribution")

    plt.tight_layout()
    fig.savefig(f"{outdir}/model_diagnostics.png", dpi=300)
    plt.close(fig)
    print(f"\nDiagnostic plots written to {outdir}/model_diagnostics.png")


# ---------------------------------------------------------------------------
# Full pipeline
# ---------------------------------------------------------------------------

def run_hybrid_pipeline(processed_csv: str, target_col: str = "soil_loss_t_ha_yr",
                         class_col: str = "erosion_class", outdir: str = "outputs",
                         model_dir: str = "models"):
    df = pd.read_csv(processed_csv)

    missing = [c for c in ALL_FEATURES if c not in df.columns]
    if missing:
        raise ValueError(f"Processed dataset is missing required features: {missing}")
    if "rusle_soil_loss" not in df.columns:
        raise ValueError(
            "Processed dataset must include 'rusle_soil_loss' "
            "(A = R x K x LS x C x P), produced by 01_data_preprocessing.py"
        )

    X = df[ALL_FEATURES]
    y_reg = df[target_col]
    y_clf = df[class_col]
    rusle_estimate = df["rusle_soil_loss"]

    (X_train, X_test, y_reg_train, y_reg_test,
     y_clf_train, y_clf_test) = split_data(X, y_reg, y_clf)

    rusle_train = rusle_estimate.loc[X_train.index]
    rusle_test = rusle_estimate.loc[X_test.index]

    # --- Train models -----------------------------------------------------
    print("\nTraining Random Forest regressor...")
    rf_regressor = train_rf_regressor(X_train, y_reg_train)

    print("Training Random Forest classifier...")
    rf_classifier = train_rf_classifier(X_train, y_clf_train)

    rf_pred_train = rf_regressor.predict(X_train)
    rf_pred_test = rf_regressor.predict(X_test)

    print("Training stacked Ridge meta-learner (RUSLE bias correction)...")
    meta_model = train_stacked_ridge_ensemble(rf_pred_train, rusle_train.values, y_reg_train.values)
    hybrid_pred_test = meta_model.predict(np.column_stack([rf_pred_test, rusle_test.values]))

    # --- Baselines ----------------------------------------------------------
    naive_pred_test = naive_average(rf_pred_test, rusle_test.values)
    weighted_pred_test = weighted_average(rf_pred_test, rusle_test.values)

    # --- Evaluate regression -------------------------------------------------
    results = {
        "RUSLE only": evaluate_regression(y_reg_test, rusle_test.values, "RUSLE only"),
        "RF only": evaluate_regression(y_reg_test, rf_pred_test, "RF only"),
        "Naive average": evaluate_regression(y_reg_test, naive_pred_test, "Naive average"),
        "Weighted average": evaluate_regression(y_reg_test, weighted_pred_test, "Weighted average"),
        "Hybrid (stacked Ridge)": evaluate_regression(y_reg_test, hybrid_pred_test, "Hybrid (stacked Ridge)"),
    }
    pd.DataFrame(results).T.to_csv(f"{outdir}/regression_model_comparison.csv")

    # --- Evaluate classification ----------------------------------------------
    clf_pred_test = rf_classifier.predict(X_test)
    clf_proba_test = rf_classifier.predict_proba(X_test)
    classes = rf_classifier.classes_

    clf_metrics = evaluate_classification(
        y_clf_test, clf_pred_test, clf_proba_test, classes, "RF classifier"
    )
    class_auc = per_class_auc(y_clf_test, clf_proba_test, classes)
    print(f"\nPer-class AUC:\n{class_auc}")

    # --- Feature importance --------------------------------------------------
    fi = get_feature_importance(rf_regressor, ALL_FEATURES)
    print(f"\nFeature importance (regressor):\n{fi}")
    fi.to_csv(f"{outdir}/feature_importance.csv", index=False)

    # --- Plots -----------------------------------------------------------
    plot_diagnostics(y_reg_test, hybrid_pred_test, fi, outdir=outdir)

    # --- Persist models ----------------------------------------------------
    Path(model_dir).mkdir(parents=True, exist_ok=True)
    joblib.dump(rf_regressor, f"{model_dir}/rf_regressor.pkl")
    joblib.dump(rf_classifier, f"{model_dir}/rf_classifier.pkl")
    joblib.dump(meta_model, f"{model_dir}/ridge_meta_model.pkl")
    print(f"\nModels saved to {model_dir}/")

    return {
        "rf_regressor": rf_regressor,
        "rf_classifier": rf_classifier,
        "meta_model": meta_model,
        "regression_results": results,
        "classification_results": clf_metrics,
        "per_class_auc": class_auc,
        "feature_importance": fi,
    }


if __name__ == "__main__":
    import argparse

    parser = argparse.ArgumentParser(description="Train the hybrid RUSLE-RF soil loss model.")
    parser.add_argument("processed_csv", help="Path to data/processed_dataset.csv from step 01")
    parser.add_argument("--outdir", default="outputs")
    parser.add_argument("--model-dir", default="models")
    args = parser.parse_args()

    run_hybrid_pipeline(args.processed_csv, outdir=args.outdir, model_dir=args.model_dir)
